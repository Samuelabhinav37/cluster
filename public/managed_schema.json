{
  "type": "object",
  "properties": {
    "athena": {
      "type": "object",
      "description": "Optional Athena enterprise connection. Leave unset for normal consumer installs.",
      "properties": {
        "tenantId": {
          "type": "string",
          "description": "Athena tenant id."
        },
        "agentId": {
          "type": "string",
          "description": "Athena security agent id returned during enrollment."
        },
        "tokenUrl": {
          "type": "string",
          "description": "HTTPS Athena agent-token endpoint."
        },
        "eventsUrl": {
          "type": "string",
          "description": "HTTPS Athena security-events endpoint."
        },
        "enrollmentSecret": {
          "type": "string",
          "description": "Enrollment credential provisioned by the organization."
        }
      }
    }
  }
}
