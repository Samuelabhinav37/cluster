{
  "manifest_version": 3,
  "name": "Cluster",
  "version": "0.1.0",
  "description": "Metadata-only inbox cleanup, rules, a screener, verified unsubscribe, and header-based phishing checks — all in your browser.",
  "action": {
    "default_title": "Cluster",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "permissions": ["identity", "storage", "tabs", "alarms"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "oauth2": {
    "client_id": "995931931748-0hjufbdg626m372dm5pi1f9toe7ausuc.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/gmail.settings.basic"
    ]
  }
}
