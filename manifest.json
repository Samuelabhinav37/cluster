{
  "manifest_version": 3,
  "name": "Cluster",
  "version": "0.1.0",
  "description": "Inbox cleanup, rules, a screener, verified unsubscribe and phishing checks in your browser. Reads bodies only of risky mail.",
  "action": {
    "default_title": "Cluster",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "storage": {
    "managed_schema": "managed_schema.json"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'"
  },
  "permissions": ["identity", "storage", "unlimitedStorage", "tabs", "alarms"],
  "host_permissions": [
    "https://gmail.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://cluster-auth.samuelabhinav37.workers.dev/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://samuelabhinav37.github.io/*"
  ],
  "optional_permissions": ["notifications"],
  "optional_host_permissions": ["https://*/*"],
  "key": ""
}
